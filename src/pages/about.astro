---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, city, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides ${serviceKeyword} and moisture control in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`About ${businessName}: mold inspection, removal, and moisture control for homes and businesses across Northern Kentucky. How a job works.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Mold inspection and removal for Northern Kentucky homes and businesses.</p>
    <PhoneCTA />
  </div>
</section>

<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt="Mold remediation crew in protective gear"
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>Mold inspection, removal, and moisture control in Boone, Kenton, and Campbell counties — basements, crawl spaces, attics, bathrooms, and wall cavities in homes, plus offices and storefronts.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Inspection.</strong> Call {phone} or send the form and describe what you're seeing or smelling. A free visual inspection looks for the mold, the moisture source, and how far it has spread. Air or surface sampling is arranged when it's needed.</p>

  <p><strong>2. Removal.</strong> The work area is contained with plastic sheeting and negative air pressure. Moldy porous materials are removed, hard surfaces are cleaned and HEPA-vacuumed, and affected areas are treated with antimicrobial products.</p>

  <p><strong>3. Moisture control.</strong> The leak, condensation, or humidity problem behind the mold is addressed — repairs, dehumidification, or crawl space encapsulation — so it's less likely to come back. Documentation is available if you're filing an insurance claim.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/mold-removal/${c.slug}/`}>Mold removal in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask — nearby towns are often fine.</p>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Found Mold in Your Home?</p>
    <p class="cta-sub">Call now for a free inspection.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
