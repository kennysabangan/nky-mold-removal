---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import { siteConfig } from '../../config';

const { businessName, phone, phoneE164, siteUrl, serviceKeyword, serviceKeywordPlural, city, region, services, cities } = siteConfig;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1),
  "provider": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": phoneE164,
  },
  "areaServed": cities.map((c) => ({ "@type": "City", "name": c.name })),
  "description": `Professional ${serviceKeywordPlural} for residential and commercial properties in ${city}.`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteUrl}/mold-removal/` },
  ],
};
---

<BaseLayout
  title="Mold Inspection, Removal & Remediation | Cincinnati & NKY"
  description={`Mold inspection, mold removal, and mold remediation for homes and businesses in Cincinnati & Northern Kentucky. Free inspection: ${phone}.`}
  canonicalURL={`${siteUrl}/mold-removal/`}
  schema={[breadcrumbSchema, serviceSchema]}
>

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <h1>Mold Removal, Remediation &amp; Inspection Services</h1>
    <p class="hero-sub">Mold inspection, removal, and moisture control for homes and businesses in {city} and the Greater Cincinnati area.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Photo -->
<div class="container py-6 text-center">
  <img
    src="/photos/hero.jpg"
    alt={`${serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} services in ${city}`}
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<!-- Services -->
<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">Our {serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} Services</h2>

  <p>{businessName} provides mold inspection, mold removal, and mold remediation for homes, offices, crawl spaces, basements, and commercial buildings throughout {city} and the Greater Cincinnati area.</p>

  <p>A mold inspection comes first: it finds where the mold is growing, how far it has spread, and the moisture source feeding it. Mold removal and mold remediation then take out the materials that can't be saved, clean the surfaces that can, and deal with the leak, condensation, or humidity behind the problem so it is less likely to come back. Here are the services we offer:</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 my-8">
    {services.map((service) => (
      <div class="service-card">
        <img src={service.photo} alt={`${service.title} — ${businessName}`} loading="lazy" />
        <div class="card-body">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How Our {serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} Service Works</h2>

  <p>Getting mold remediated by {businessName} is easy. Here's how it works:</p>

  <p><strong>Step 1: Call Us.</strong> Give us a call at {phone} and describe what you're seeing or smelling. We'll schedule a free on-site inspection to assess the situation.</p>

  <p><strong>Step 2: Get Your Free Inspection.</strong> We'll inspect your property, arrange air or surface testing if it's needed, and give you a clear price for remediation before any work starts.</p>

  <p><strong>Step 3: We Remove the Mold.</strong> Our team sets up containment barriers, uses HEPA filtration and negative air pressure, and removes the mold and any moldy materials that can't be cleaned. Affected surfaces are treated with antimicrobial solutions.</p>

  <p><strong>Step 4: Fix the Moisture.</strong> Mold comes back wherever the water does, so the leak, condensation, or crawl space humidity behind it is addressed with repairs, dehumidification, or encapsulation. Ask about follow-up testing if you want confirmation the work area is clean.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">{serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} Service Areas</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/mold-removal/${c.slug}/`}>{serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} in {c.name}</a></li>
    ))}
  </ul>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Found Mold in Your Home?</p>
    <p class="cta-sub">Call now for a free {serviceKeyword} estimate in {city}.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Final CTA -->
<section class="bg-brand-dark text-white">
  <div class="cta-strip container">
    <h2 class="text-white text-xl md:text-2xl font-bold mb-2">Call Now for {serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} in {city}</h2>
    <p class="text-white/90 text-base mb-4">We provide {serviceKeywordPlural} across {region}.</p>
    <PhoneCTA label="Call Now" />
  </div>
</section>

</BaseLayout>
